{
  "name": "@rack-mcp/mcp-server",
  "version": "0.7.3",
  "license": "MIT",
  "description": "Model Context Protocol (MCP) server over stdio, 50-step atomic Undo/Redo state manager, and local WebSocket/REST sidecar server for RackArchitect MCP.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@rack-mcp/core-domain": "workspace:*",
    "@rack-mcp/exporters": "workspace:*",
    "@rack-mcp/hardware-catalog": "workspace:*",
    "ws": "^8.22.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.12"
  },
  "mcpName": "io.github.itAlex240/rack-architect-mcp"
}
